  # permission_handler:
  #   git:
  #     url: https://gitcode.com/CPF-Flutter/flutter_permission_handler.git
  #     path: permission_handler
  #     ref: br_permission_handler_v11.3.1_ohos

  # package_info_plus 8.1.0 (项目 ^8.0.2)
