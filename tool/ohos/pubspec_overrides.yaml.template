# OHOS 构建专用依赖覆盖（复制为根目录 pubspec_overrides.yaml 使用，勿提交）
# 复制命令: Copy-Item tool\ohos\pubspec_overrides.yaml.template pubspec_overrides.yaml
#
# 来源: CPF-Flutter 组织 (https://gitcode.com/CPF-Flutter)
# 适配总表: https://gitcode.com/CPF-Flutter/docs/blob/main/ThirdpartyLibrarites.md
# 分支名为 2026-10-17 查证结果, P0 阶段需逐项核实分支存在性与 API 兼容性。
# 标注 [P0核实] 的条目需确认分支名; 确认后移除注释使用。
#
# 注意: dependency_overrides 会同时作用于所有平台。构建 Android/iOS 时
# 删除根目录的 pubspec_overrides.yaml 即可回到官方依赖。

dependency_overrides:
  # ---- 已确认 3.27 适配, 版本完全一致或兼容 ----
  # permission_handler: 官方 fluttertpc 适配, br_permission_handler_v11.3.1_ohos
